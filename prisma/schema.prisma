generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id             String                 @id @default(cuid())
  email          String                 @unique
  name           String?
  image          String?
  passwordHash   String?
  role           Role                   @default(STUDENT)
  emailVerified  Boolean                @default(false)
  verifyToken    String?
  resetToken     String?
  resetExpiry    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  aiChats        AIChat[]
  auditLogs      AuditLog[]
  certificates   Certificate[]
  certifications Certification[]        @relation("InstructorCerts")
  posts          CommunityPost[]
  replies        CommunityReply[]
  enrollments    Enrollment[]
  examAttempts   ExamAttempt[]
  instructorSubs InstructorSubmission[]
  payments       Payment[]
  postVotes      PostVote[]
  profile        Profile?
  submissions    Submission[]
  xpTransactions XPTransaction[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  avatar      String?
  bio         String?
  xp          Int      @default(0)
  level       Int      @default(1)
  streak      Int      @default(0)
  lastActive  DateTime @default(now())
  badges      Json     @default("[]")
  socialLinks Json     @default("{}")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp(sort: Desc)])
}

model Certification {
  id               String                 @id @default(cuid())
  instructorId     String
  title            String
  slug             String                 @unique
  description      String
  longDescription  String?
  category         String
  difficulty       Difficulty
  price            Decimal                @db.Decimal(10, 2)
  currency         String                 @default("USD")
  status           CertStatus             @default(DRAFT)
  thumbnail        String?
  learningOutcomes Json                   @default("[]")
  prerequisites    Json                   @default("[]")
  tags             String[]               @default([])
  totalChapters    Int                    @default(0)
  duration         Int?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  aiChats          AIChat[]
  assessments      Assessment[]
  certificates     Certificate[]
  instructor       User                   @relation("InstructorCerts", fields: [instructorId], references: [id])
  chapters         Chapter[]
  codingProblems   CodingProblem[]
  enrollments      Enrollment[]
  submissions      InstructorSubmission[]

  @@index([category])
  @@index([status])
  @@index([difficulty])
  @@index([slug])
}

model Chapter {
  id        String        @id @default(cuid())
  certId    String
  title     String
  order     Int
  pdfUrl    String?
  pdfKey    String?
  content   String?
  summary   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cert      Certification @relation(fields: [certId], references: [id], onDelete: Cascade)
  ragChunks RAGChunk[]

  @@index([certId, order])
}

model Assessment {
  id          String         @id @default(cuid())
  certId      String
  title       String
  description String?
  type        AssessmentType
  passMark    Int            @default(70)
  timeLimit   Int?
  negMark     Float          @default(0)
  randomize   Boolean        @default(true)
  maxAttempts Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cert        Certification  @relation(fields: [certId], references: [id], onDelete: Cascade)
  attempts    ExamAttempt[]
  questions   Question[]

  @@index([certId])
  @@index([type])
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  type         QuestionType
  body         String
  options      Json?
  answer       String
  explanation  String?
  points       Int          @default(1)
  difficulty   Difficulty   @default(INTERMEDIATE)
  order        Int          @default(0)
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model ExamAttempt {
  id           String     @id @default(cuid())
  userId       String
  assessmentId String
  answers      Json
  score        Float
  maxScore     Float      @default(100)
  passed       Boolean
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([userId, assessmentId])
  @@index([passed])
}

model Enrollment {
  id          String        @id @default(cuid())
  userId      String
  certId      String
  paidAmount  Decimal       @db.Decimal(10, 2)
  progress    Float         @default(0)
  completedAt DateTime?
  enrolledAt  DateTime      @default(now())
  cert        Certification @relation(fields: [certId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@unique([userId, certId])
  @@index([userId])
  @@index([certId])
}

model Certificate {
  id            String        @id @default(cuid())
  userId        String
  certId        String
  certificateId String        @unique
  pdfUrl        String
  score         Float?
  issuedAt      DateTime      @default(now())
  cert          Certification @relation(fields: [certId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([certificateId])
  @@index([userId])
}

model Payment {
  id        String         @id @default(cuid())
  userId    String
  certId    String
  gateway   PaymentGateway
  gatewayId String         @unique
  orderId   String?
  amount    Decimal        @db.Decimal(10, 2)
  currency  String
  status    PaymentStatus  @default(PENDING)
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model CodingProblem {
  id          String         @id @default(cuid())
  certId      String?
  title       String
  slug        String         @unique
  description String
  difficulty  Difficulty
  tags        String[]       @default([])
  starterCode Json           @default("{}")
  testCases   Json           @default("[]")
  constraints String?
  hints       Json           @default("[]")
  solution    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cert        Certification? @relation(fields: [certId], references: [id])
  submissions Submission[]

  @@index([difficulty])
  @@index([certId])
}

model Submission {
  id        String           @id @default(cuid())
  userId    String
  problemId String
  code      String
  language  String
  status    SubmissionStatus @default(PENDING)
  results   Json             @default("[]")
  runtime   Float?
  memory    Int?
  createdAt DateTime         @default(now())
  problem   CodingProblem    @relation(fields: [problemId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, problemId])
  @@index([status])
  @@index([userId])
}

model CommunityPost {
  id        String           @id @default(cuid())
  userId    String
  certId    String?
  title     String
  body      String
  tags      String[]         @default([])
  upvotes   Int              @default(0)
  views     Int              @default(0)
  pinned    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
  replies   CommunityReply[]
  votes     PostVote[]

  @@index([certId])
  @@index([upvotes(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  body      String
  upvotes   Int           @default(0)
  accepted  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([postId])
}

model PostVote {
  id     String        @id @default(cuid())
  postId String
  userId String
  value  Int
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model AIChat {
  id        String         @id @default(cuid())
  userId    String
  certId    String?
  chapterId String?
  title     String?
  messages  Json           @default("[]")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cert      Certification? @relation(fields: [certId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@index([userId, certId])
}

model RAGChunk {
  id         String   @id @default(cuid())
  chapterId  String
  text       String
  page       Int?
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model InstructorSubmission {
  id           String        @id @default(cuid())
  instructorId String
  certId       String
  status       CertStatus    @default(PENDING_REVIEW)
  adminNote    String?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime      @default(now())
  cert         Certification @relation(fields: [certId], references: [id])
  instructor   User          @relation(fields: [instructorId], references: [id])

  @@index([status])
  @@index([instructorId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CertStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum QuestionType {
  MCQ
  MSQ
  TRUE_FALSE
  FILL_BLANK
  CODING
}

enum AssessmentType {
  QUIZ
  PRACTICE
  CERTIFICATION_EXAM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
}
